generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ContactKind {
  GITHUB
  TELEGRAM
  EMAIL
  PHONE
}

model Profile {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique @default("main")
  name        String
  title       String
  description String    @db.Text @map("summary")
  location    String
  contacts    Contact[]
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("profile")
}

model Contact {
  id        String      @id @default(uuid()) @db.Uuid
  kind      ContactKind
  label     String
  value     String
  position  Int         @default(0)
  profileId String      @map("profile_id") @db.Uuid
  profile   Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, kind])
  @@index([profileId])
  @@map("contact")
}

model Skill {
  id       String            @id @default(uuid()) @db.Uuid
  name     String            @unique
  category String
  usedIn   ExperienceSkill[]
  applied  ProjectSkill[]

  @@index([category])
  @@map("skill")
}

model Experience {
  id          String            @id @default(uuid()) @db.Uuid
  slug        String            @unique
  company     String
  position    String
  startDate   DateTime          @db.Date @map("start_date")
  endDate     DateTime?         @db.Date @map("end_date")
  sortOrder   Int               @default(0) @map("sort_order")
  achievements Achievement[]
  skills      ExperienceSkill[]

  @@index([sortOrder])
  @@map("experience")
}

model Achievement {
  id           String     @id @default(uuid()) @db.Uuid
  text         String     @db.Text
  position     Int
  experienceId String     @map("experience_id") @db.Uuid
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@unique([experienceId, position])
  @@map("achievement")
}

model ExperienceSkill {
  experienceId String     @map("experience_id") @db.Uuid
  skillId      String     @map("skill_id") @db.Uuid
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([experienceId, skillId])
  @@index([skillId])
  @@map("experience_skill")
}

model Project {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @unique
  description   String         @db.Text
  repositoryUrl String         @map("repository_url")
  liveUrl       String?        @map("live_url")
  period        String
  tech          String[]
  featured      Boolean        @default(false)
  sortOrder     Int            @default(0) @map("sort_order")
  skills        ProjectSkill[]

  @@index([featured, sortOrder])
  @@map("project")
}

model ProjectSkill {
  projectId String  @map("project_id") @db.Uuid
  skillId   String  @map("skill_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
  @@index([skillId])
  @@map("project_skill")
}
{
  "name": "resume-backend",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS GraphQL API over a resume stored in PostgreSQL",
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "test": "jest",
    "test:unit": "jest --testPathPatterns \"\\.spec\\.ts$\" --testPathIgnorePatterns \"/node_modules/\" \".*\\.e2e-spec\\.ts$\"",
    "test:e2e": "jest --testPathPatterns \"\\.e2e-spec\\.ts$\"",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "13.4.5",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.3",
    "@nestjs/core": "11.2.7",
    "@nestjs/graphql": "13.4.5",
    "@nestjs/platform-express": "11.2.7",
    "@prisma/client": "6.19.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "graphql": "16.14.2",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.0.10",
    "@nestjs/testing": "11.2.7",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.(e2e-spec|spec)\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.module.ts",
      "!**/main.ts",
      "!**/*-fixture.ts",
      "!**/*.e2e-fixture.ts",
      "!**/*.e2e-env.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
